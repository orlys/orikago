{
  "$schema": "http://json.schemastore.org/template",
  "author": "Orlys",
  "classifications": [ "Go", "Console" ],
  "identity": "Orikago.Console",
  "name": "Orikago Console App",
  "shortName": "go-console",
  "description": "A Go console application whose go toolchain is driven by dotnet build / run / test (Orikago.Sdk).",
  "tags": {
    "language": "Go",
    "type": "project"
  },
  "sourceName": "OrikagoApp",
  "preferNameDirectory": true,
  "forms": {
    "lowercase": { "identifier": "lowerCase" },
    "goModuleChars": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9._~-]",
      "replacement": "_"
    },
    "goModuleCollapse": {
      "identifier": "replace",
      "pattern": "_+",
      "replacement": "_"
    },
    "goModuleTrimDots": {
      "identifier": "replace",
      "pattern": "^[.]+|[.]+$",
      "replacement": ""
    },
    "goModuleSafe": {
      "identifier": "chain",
      "steps": [ "lowercase", "goModuleChars", "goModuleCollapse", "goModuleTrimDots" ]
    }
  },
  "symbols": {
    "goModuleName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "goModuleSafe",
      "replaces": "GO_MODULE_NAME",
      "description": "Module path for go.mod: the project name lowercased and ASCII-sanitized (Go module paths are lowercase by convention; illegal characters become _)."
    },
    "langVersion": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Go language version, written to <LangVersion> in the .goproj and the go directive in go.mod.",
      "defaultValue": "1.21",
      "replaces": "GO_LANG_VERSION",
      "displayName": "Go language version",
      "choices": [
        {
          "choice": "1.13",
          "description": "Go 1.13 (no generics; language features are gated by the go.mod directive)"
        },
        {
          "choice": "1.18",
          "description": "Go 1.18 (introduces generics)"
        },
        {
          "choice": "1.21",
          "description": "Go 1.21 (default; matches the local toolchain)"
        },
        {
          "choice": "1.22",
          "description": "Go 1.22 (requires GOTOOLCHAIN to download the matching toolchain)"
        },
        {
          "choice": "1.23",
          "description": "Go 1.23"
        },
        {
          "choice": "1.24",
          "description": "Go 1.24"
        },
        {
          "choice": "1.25",
          "description": "Go 1.25"
        }
      ]
    }
  },
  "primaryOutputs": [
    { "path": "OrikagoApp.goproj" }
  ]
}
