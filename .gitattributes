# GitHub's Linguist does not know these extensions and shows them as plain text.
# They are VSSDK XML, and .pkgdef is the .reg format. (.goproj needs no entry: it
# starts with an XML declaration, which Linguist detects on its own.)
*.vsct linguist-language=XML
*.imagemanifest linguist-language=XML
*.pkgdef linguist-language=windows-registry-entries
