<?xml version="1.0" encoding="utf-8"?>
<!-- Orikago.Sdk / Sdk / GoDiagnostics.targets -->
<!-- -->
<!-- The <GoExec> task: a drop-in replacement for <Exec> that understands the Go -->
<!-- toolchain's diagnostic format and re-emits it through MSBuild's *structured* -->
<!-- error channel, so Go compiler / vet / test diagnostics land in the Visual -->
<!-- Studio Error List with a real file, line and column - double-clicking one -->
<!-- navigates to the offending .go source instead of to Sdk.targets inside the -->
<!-- NuGet cache. -->
<!-- -->
<!-- Why not Exec + CustomErrorRegularExpression? -->
<!--   CustomErrorRegularExpression only decides *which* lines Exec forwards to -->
<!--   Log.LogError(string). That single-argument overload carries no file/line/ -->
<!--   column, so MSBuild attributes the error to the location of the *task* - -->
<!--   i.e. Sdk.targets in %NUGET_PACKAGES%. Navigation stays broken. The only way -->
<!--   to populate the canonical fields is the 10-argument overload -->
<!--   Log.LogError(subcategory, code, helpKeyword, file, line, col, endLine, -->
<!--   endCol, message), which requires a real task - hence this inline task. -->
<!-- -->
<!-- Why RoslynCodeTaskFactory? -->
<!--   It is the only inline-task factory that works under BOTH .NET (dotnet -->
<!--   build / MSBuild Core) and .NET Framework (Visual Studio's MSBuild.exe), so -->
<!--   the SDK package still ships nothing but MSBuild logic - no assembly to -->
<!--   build, sign or pack, and no VSIX dependency for command-line builds. -->
<!-- -->
<!-- Go diagnostic shapes handled (verified against go 1.21.5 on Windows): -->
<!-- -->
<!--   # example.com/m/sub                              <- package header -->
<!--   sub\a.go:11:23: cannot use impl{} ... (wrong type for method Do) -->
<!--   <TAB><TAB>have Do(string) error                  <- continuation lines -->
<!--   <TAB><TAB>want Do(int) error -->
<!--   # example.com/m -->
<!--   .\main.go:6:14: undefined: undefinedThing        <- ".\" / "./" prefix -->
<!--   vet.exe: .\main.go:6:13: string literal not terminated -->
<!--   (dash dash dash) FAIL: TestB (0.00s)             <- go test -->
<!--       a_test.go:8: B() = 1, want 2                 <- basename only! -->
<!--   FAIL    example.com/m/sub       0.409s -->
<Project>

  <UsingTask TaskName="GoExec"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Command ParameterType="System.String" Required="true" />
      <WorkingDirectory ParameterType="System.String" Required="true" />
      <EnvironmentVariables ParameterType="System.String[]" />
      <!-- GOBUILD / GOVET / GOTEST - becomes the MSBuild error code. -->
      <ErrorCode ParameterType="System.String" />
      <ExitCode ParameterType="System.Int32" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.Diagnostics" />
      <Using Namespace="System.Globalization" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
#nullable enable

// Resolve the error code and the directory the command runs in.
var code = (ErrorCode is { Length: > 0 } errorCode) ? errorCode : "GO";
var isTest = string.Equals(code, "GOTEST", StringComparison.OrdinalIgnoreCase);

var workingDirectory = Directory.GetCurrentDirectory();
if (WorkingDirectory is { Length: > 0 } requestedDirectory)
{
    try
    {
        workingDirectory = Path.GetFullPath(requestedDirectory);
    }
    catch (Exception exception)
    {
        // The requested directory cannot be resolved: run from the current one.
        Log.LogMessage(
            importance: MessageImportance.Low,
            message: "Orikago.Sdk: could not resolve working directory \"" +
            requestedDirectory + "\" (" + exception.Message +
            "); using the current directory.");
    }
}

Log.LogMessage(MessageImportance.Low, Command);

// file:line[:col]: message  - the Go toolchain's diagnostic format. The
// extension set mirrors @(GoNativeCompile) in Sdk.props: cgo builds forward
// the C/C++/ObjC/Fortran compiler's "helper.cpp:3:5: error: ..." lines
// verbatim, and those must navigate from the Error List too.
var diagnosticRegex = new Regex(
    pattern: @"^(?<file>(?:[A-Za-z]:)?[^:\r\n]*?\." +
    @"(?:go|swigcxx|swig|sx|s|S|cxx|cpp|cc|c|hxx|hpp|hh|h|mm|m|f90|for|F|f))" +
    @":(?<line>\d+)(?::(?<column>\d+))?:\s*(?<message>.*)$",
    options: RegexOptions.CultureInvariant);

// ------------------------------------------------------------------
// File resolution.
//
// go build/vet emit paths relative to the working directory, but the
// testing package strips every directory component (testing.go does
// file = file[lastIndexByte(file,'/')+1:]), so "a_test.go:8:" for a test
// living in sub/ would resolve to a non-existent <root>\a_test.go. When the
// direct resolution misses, fall back to a one-shot index of source-file
// base names under the working directory; only an unambiguous hit is used.
// ------------------------------------------------------------------
var nameIndex = default(Dictionary<string, string?>);

var sourceExtensions = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
{
    ".go",
    ".s",
    ".sx",
    ".c",
    ".cc",
    ".cpp",
    ".cxx",
    ".m",
    ".mm",
    ".h",
    ".hh",
    ".hpp",
    ".hxx",
    ".f",
    ".for",
    ".f90",
    ".swig",
    ".swigcxx"
};

string? LookupByName(string name)
{
    if (nameIndex is null)
    {
        // First lookup: index the source files under the working directory once.
        const int MAX_INDEXED_FILES = 20000;
        nameIndex = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
        var pending = new Stack<string>();
        pending.Push(workingDirectory);
        var budget = MAX_INDEXED_FILES;
        while ((pending.Count > 0) && (budget > 0))
        {
            var directory = pending.Pop();
            var files = default(string[]);
            try
            {
                files = Directory.GetFiles(directory);
            }
            catch (Exception exception)
            {
                // An unreadable directory is skipped together with its subdirectories.
                Log.LogMessage(
                    importance: MessageImportance.Low,
                    message: "Orikago.Sdk: skipped \"" + directory + "\" (" +
                    exception.Message + ").");
                continue;
            }

            // Record every source file by base name.
            for (var i = 0; (i < files.Length) && (budget > 0); i++)
            {
                if (!sourceExtensions.Contains(Path.GetExtension(files[i])))
                {
                    // Not a source file the toolchain reports diagnostics for.
                    continue;
                }
                budget--;
                var key = Path.GetFileName(files[i]);
                if (nameIndex.ContainsKey(key))
                {
                    // Ambiguous base name: refuse to guess (null = known-ambiguous).
                    nameIndex[key] = null;
                    continue;
                }
                nameIndex[key] = files[i];
            }

            var subdirectories = default(string[]);
            try
            {
                subdirectories = Directory.GetDirectories(directory);
            }
            catch (Exception exception)
            {
                // The subdirectories cannot be listed: this branch of the tree ends here.
                Log.LogMessage(
                    importance: MessageImportance.Low,
                    message: "Orikago.Sdk: skipped subdirectories of \"" + directory +
                    "\" (" + exception.Message + ").");
                continue;
            }

            // Queue the subdirectories the go command itself would look into.
            foreach (var subdirectory in subdirectories)
            {
                var leaf = Path.GetFileName(subdirectory);
                if (leaf is not { Length: > 0 })
                {
                    // No directory name to judge by.
                    continue;
                }
                if (leaf[0] is '.' or '_')
                {
                    // Go ignores these directories too.
                    continue;
                }
                if (string.Equals(leaf, "bin", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(leaf, "obj", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(leaf, "node_modules", StringComparison.OrdinalIgnoreCase))
                {
                    // Build output and package folders hold no sources of this module.
                    continue;
                }
                pending.Push(subdirectory);
            }
        }
    }
    return nameIndex.TryGetValue(name, out var hit) ? hit : null;
}

string ResolveFile(string raw)
{
    var file = raw;
    if (file.StartsWith("./", StringComparison.Ordinal) ||
        file.StartsWith(".\\", StringComparison.Ordinal))
    {
        // Relative to the working directory, spelled with an explicit "./" prefix.
        file = file.Substring(2);
    }
    file = file.Replace('/', Path.DirectorySeparatorChar);

    var absolutePath = default(string);
    try
    {
        absolutePath = Path.IsPathRooted(file)
            ? Path.GetFullPath(file)
            : Path.GetFullPath(Path.Combine(workingDirectory, file));
    }
    catch (Exception exception)
    {
        // Not a valid path: report the location exactly as the tool printed it.
        Log.LogMessage(
            importance: MessageImportance.Low,
            message: "Orikago.Sdk: could not resolve \"" + raw + "\" (" +
            exception.Message + ").");
        return raw;
    }
    if (File.Exists(absolutePath))
    {
        return absolutePath;
    }

    // The testing package prints base names only: use an unambiguous index hit.
    return LookupByName(Path.GetFileName(file)) ?? absolutePath;
}

// ------------------------------------------------------------------
// Diagnostic buffering: a diagnostic is only emitted once the following
// line proves it has no more tab-indented continuation lines.
// ------------------------------------------------------------------
var havePending = default(bool);
var pendingDeferred = default(bool);
var pendingFile = default(string);
var pendingLine = default(int);
var pendingColumn = default(int);
var pendingMessage = default(string);
var pendingRawLine = default(string);
var loggedStructuredError = default(bool);

// Verdict-pending testing.T output. `go test` (non-verbose) prints
// "--- FAIL: TestX" BEFORE the test's log lines, but `go test -v` prints the
// log lines FIRST and the verdict afterwards - and t.Logf and t.Errorf produce
// byte-identical output. So an indented "file.go:N: text" line seen while its
// test's verdict is still unknown has to be held.
//
// The hold is PER TEST. Resolving the whole buffer with whichever verdict
// arrives next is wrong as soon as more than one test is in flight: under
// t.Parallel() / -parallel, a sibling that logs and PASSES before the failing
// test reaches its verdict would consume the failure's buffered
// "file.go:N:" location and downgrade it to plain output - the Error List then
// gets only the generic "command exited with code 1", with nothing to navigate
// to. `go test -v` names the owning test on every "=== RUN/PAUSE/CONT/NAME"
// line, so that name is tracked and stamped on each held entry, and a verdict
// releases only the entries belonging to the test it names.
List<(string? File, int Line, int Column, string? Message, string? RawLine, string? TestName)>
    testBuffer = [];
var failedTests = new HashSet<string>(StringComparer.Ordinal);
var currentTest = default(string);

// "--- FAIL: TestX/sub (0.00s)" -> verdict + test name.
var verdictRegex = new Regex(
    pattern: @"^---[ \t]+(?<verdict>[A-Za-z]+):[ \t]+(?<name>\S+)",
    options: RegexOptions.CultureInvariant);
// "=== RUN   TestX" / "=== CONT  TestX" / "=== PAUSE TestX" / "=== NAME TestX"
// (and "=== FAIL: TestX", which some versions emit) -> owner of what follows.
var ownerRegex = new Regex(
    pattern: @"^===[ \t]+(?<action>[A-Za-z]+):?[ \t]+(?<name>\S+)",
    options: RegexOptions.CultureInvariant);

// The 10-argument overload: this is what puts file/line/column on the
// event, which is what makes Error List navigation work.
void LogStructuredError(string? file, int line, int column, string? message)
{
    Log.LogError(
        subcategory: null,
        errorCode: code,
        helpKeyword: null,
        file,
        lineNumber: line,
        columnNumber: column,
        endLineNumber: 0,
        endColumnNumber: 0,
        message);
    loggedStructuredError = true;
}

void EmitTestEntry(
    (string? File, int Line, int Column,
        string? Message, string? RawLine, string? TestName) entry,
    bool asError)
{
    if (asError)
    {
        // The owning test failed: the held line is one of its errors.
        LogStructuredError(entry.File, entry.Line, entry.Column, entry.Message);
        return;
    }
    Log.LogMessage(MessageImportance.High, entry.RawLine);
}

// A verdict for <name> releases the entries owned by <name>, in order.
// Entries with no owner (output seen before any test line named one - not
// something `go test` actually produces, but the parser must not lose them)
// go with the first verdict to arrive, which is the pre-existing behaviour.
void ResolveTest(string? name, bool asErrors)
{
    if (name is null)
    {
        // No test named: nothing to release.
        return;
    }
    var i = default(int);
    while (i < testBuffer.Count)
    {
        var entry = testBuffer[i];
        if ((entry.TestName is not null) &&
            !string.Equals(entry.TestName, name, StringComparison.Ordinal))
        {
            // Owned by another test: it waits for that test's verdict.
            i++;
            continue;
        }
        testBuffer.RemoveAt(i);
        EmitTestEntry(entry, asErrors);
    }
}

// End of stream. A test that never produced a verdict cannot be shown to have
// failed, so its held lines are replayed as plain output rather than promoted.
void DrainTestBuffer()
{
    foreach (var entry in testBuffer)
    {
        EmitTestEntry(entry, false);
    }
    testBuffer.Clear();
    failedTests.Clear();
    currentTest = null;
}

void Flush()
{
    if (!havePending)
    {
        // No diagnostic is waiting.
        return;
    }
    havePending = false;
    if (pendingDeferred)
    {
        if ((currentTest is not null) && failedTests.Contains(currentTest))
        {
            // Verdict already in hand (non-verbose `go test`, which prints
            // "--- FAIL:" before the test's output): straight to the Error List.
            LogStructuredError(pendingFile, pendingLine, pendingColumn, pendingMessage);
            return;
        }

        // Verdict still unknown: hold the line for the owning test.
        testBuffer.Add((
            File: pendingFile,
            Line: pendingLine,
            Column: pendingColumn,
            Message: pendingMessage,
            RawLine: pendingRawLine,
            TestName: currentTest));
        return;
    }
    LogStructuredError(pendingFile, pendingLine, pendingColumn, pendingMessage);
}

void ProcessLine(string? raw)
{
    if (raw is null)
    {
        // No line to process.
        return;
    }
    var line = raw.TrimEnd('\r', '\n');
    if (string.IsNullOrWhiteSpace(line))
    {
        // A blank line ends the pending diagnostic.
        Flush();
        return;
    }

    if ((line[0] is '\t') && havePending)
    {
        // Continuation of the previous diagnostic ("have ..." / "want ...").
        // Folded into a single line: MSBuild re-prefixes every line of a multi-line
        // error message with "file(l,c): error CODE:", which would make one
        // diagnostic look like three in the build output.
        pendingMessage = pendingMessage + "; " + line.Trim();
        pendingRawLine = pendingRawLine + Environment.NewLine + line;
        return;
    }

    var trimmed = line.TrimStart(' ', '\t');
    var indented = trimmed.Length != line.Length;

    // "vet: " / "vet.exe: " prefix on go vet's own hard failures.
    var scan = trimmed switch
    {
        _ when trimmed.StartsWith("vet: ", StringComparison.Ordinal) => trimmed.Substring(5),
        _ when trimmed.StartsWith("vet.exe: ", StringComparison.Ordinal) => trimmed.Substring(9),
        _ => trimmed,
    };

    if (scan.StartsWith("# ", StringComparison.Ordinal))
    {
        // Package header - context only, never an error of its own.
        Flush();
        Log.LogMessage(MessageImportance.High, line);
        return;
    }

    if (trimmed.StartsWith("--- ", StringComparison.Ordinal))
    {
        // go test verdict line (FAIL / PASS / SKIP / BENCH). Flush() runs FIRST,
        // while currentTest still names the test the pending diagnostic came
        // from - the verdict line retargets ownership only for what follows it.
        Flush();
        Log.LogMessage(MessageImportance.High, line);
        if (verdictRegex.Match(trimmed) is { Success: true } verdictMatch)
        {
            var name = verdictMatch.Groups["name"].Value;
            var verdict = verdictMatch.Groups["verdict"].Value;
            var failed = string.Equals(verdict, "FAIL", StringComparison.OrdinalIgnoreCase);
            currentTest = name;
            if (failed)
            {
                failedTests.Add(name);
            }
            else
            {
                failedTests.Remove(name);
            }
            ResolveTest(name, failed);
        }
        return;
    }

    if (trimmed.StartsWith("=== ", StringComparison.Ordinal))
    {
        // go test progress line (RUN / PAUSE / CONT / NAME / FAIL). Deliberately
        // does NOT resolve the buffer: under -parallel the verdict for an
        // already-started test can still be several lines away. It does re-point
        // the OWNER - everything `go test -v` prints after this line belongs to
        // the test it names, until the next such line.
        Flush();
        Log.LogMessage(MessageImportance.High, line);
        if (ownerRegex.Match(trimmed) is { Success: true } ownerMatch)
        {
            var action = ownerMatch.Groups["action"].Value;
            var name = ownerMatch.Groups["name"].Value;
            currentTest = name;
            if (string.Equals(action, "RUN", StringComparison.OrdinalIgnoreCase))
            {
                // -count=N reruns the same name.
                failedTests.Remove(name);
            }
            if (string.Equals(action, "FAIL", StringComparison.OrdinalIgnoreCase))
            {
                failedTests.Add(name);
                ResolveTest(name, true);
            }
        }
        return;
    }

    if (trimmed.StartsWith("ok ", StringComparison.Ordinal) ||
        trimmed.StartsWith("ok\t", StringComparison.Ordinal) ||
        trimmed.StartsWith("FAIL\t", StringComparison.Ordinal) ||
        trimmed.StartsWith("?   ", StringComparison.Ordinal) ||
        trimmed.StartsWith("?\t", StringComparison.Ordinal) ||
        (trimmed is "PASS" or "FAIL"))
    {
        // Package-level summary: no test owns what comes after it.
        Flush();
        Log.LogMessage(MessageImportance.High, line);
        currentTest = null;
        return;
    }

    if (diagnosticRegex.Match(scan) is not { Success: true } diagnostic)
    {
        // Not a diagnostic: plain tool output.
        Flush();
        Log.LogMessage(MessageImportance.High, line);
        return;
    }

    Flush();

    // An unparsable (or, for the column, absent) number becomes 0, as TryParse leaves it.
    int.TryParse(
        s: diagnostic.Groups["line"].Value,
        style: NumberStyles.Integer,
        provider: CultureInfo.InvariantCulture,
        result: out var lineNumber);
    int.TryParse(
        s: diagnostic.Groups["column"].Value,
        style: NumberStyles.Integer,
        provider: CultureInfo.InvariantCulture,
        result: out var columnNumber);

    // Hold the diagnostic until the next line proves it complete. An indented
    // "file.go:N: text" line under `go test` is testing.T output. t.Logf produces
    // exactly the same shape as t.Errorf, so it may only be promoted to an error
    // once its OWN test is known to have failed - otherwise a passing test's log
    // line would break the build. Flush() routes it: an error immediately when
    // that test's verdict is already in (non-verbose go test), otherwise into
    // testBuffer tagged with the owning test name.
    havePending = true;
    pendingDeferred = isTest && indented;
    pendingFile = ResolveFile(diagnostic.Groups["file"].Value);
    pendingLine = lineNumber;
    pendingColumn = columnNumber;
    pendingMessage = diagnostic.Groups["message"].Value;
    pendingRawLine = line;
}

// ------------------------------------------------------------------
// Run the command.
// ------------------------------------------------------------------
List<string> standardOutputLines = [];
List<string> standardErrorLines = [];
var exitCode = default(int);
var started = default(bool);

var startInfo = new ProcessStartInfo();
if (Path.DirectorySeparatorChar == '\\')
{
    // Windows: /S + surrounding quotes make cmd strip only the outer pair and
    // pass the rest through verbatim, so embedded quotes in -ldflags survive.
    var commandShell = (Environment.GetEnvironmentVariable("ComSpec") is { Length: > 0 } comSpec)
        ? comSpec
        : "cmd.exe";
    startInfo.FileName = commandShell;
    startInfo.Arguments = "/S /C \"" + Command + "\"";
}
else
{
    // Elsewhere: sh -c with the command escaped as one double-quoted word.
    startInfo.FileName = "/bin/sh";
    startInfo.Arguments =
        "-c \"" + Command.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\"";
}
startInfo.WorkingDirectory = workingDirectory;
startInfo.UseShellExecute = false;
startInfo.CreateNoWindow = true;
startInfo.RedirectStandardOutput = true;
startInfo.RedirectStandardError = true;
startInfo.StandardOutputEncoding = new UTF8Encoding(false);
startInfo.StandardErrorEncoding = new UTF8Encoding(false);

if (EnvironmentVariables is not null)
{
    // Apply the NAME=value overrides; malformed entries are ignored.
    foreach (var entry in EnvironmentVariables)
    {
        if (entry is not { Length: > 0 })
        {
            // Empty entry.
            continue;
        }
        var separator = entry.IndexOf('=');
        if (separator <= 0)
        {
            // Not of the form NAME=value.
            continue;
        }
        startInfo.Environment[entry.Substring(0, separator)] = entry.Substring(separator + 1);
    }
}

try
{
    using var process = new Process();
    process.StartInfo = startInfo;
    process.OutputDataReceived += (sender, e) =>
    {
        if (e.Data is not null)
        {
            lock (standardOutputLines)
            {
                standardOutputLines.Add(e.Data);
            }
        }
    };
    process.ErrorDataReceived += (sender, e) =>
    {
        if (e.Data is not null)
        {
            lock (standardErrorLines)
            {
                standardErrorLines.Add(e.Data);
            }
        }
    };
    process.Start();
    started = true;
    process.BeginOutputReadLine();
    process.BeginErrorReadLine();
    process.WaitForExit();
    exitCode = process.ExitCode;
}
catch (Exception exception)
{
    // The command could not be run (or waited for) at all.
    Log.LogError(
        subcategory: null,
        errorCode: code,
        helpKeyword: null,
        file: null,
        lineNumber: 0,
        columnNumber: 0,
        endLineNumber: 0,
        endColumnNumber: 0,
        message: "Orikago.Sdk: failed to run \"" + Command + "\": " + exception.Message);
    exitCode = started ? exitCode : -1;
}

// Each stream is replayed whole so that a diagnostic never gets separated from
// its tab-indented continuation lines by an interleaved line from the other
// stream. go build/vet write diagnostics to stderr; go test writes test output
// to stdout - within a stream the original order is preserved exactly.
foreach (var standardErrorLine in standardErrorLines)
{
    ProcessLine(standardErrorLine);
}
Flush();
DrainTestBuffer();
foreach (var standardOutputLine in standardOutputLines)
{
    ProcessLine(standardOutputLine);
}
Flush();
DrainTestBuffer();

ExitCode = exitCode;

if ((exitCode != 0) && !loggedStructuredError)
{
    // The command failed without a single structured diagnostic, so fall back to
    // a generic "command failed" error. Only here - otherwise the generic message
    // would shadow the real Go diagnostic in the Error List (which is exactly
    // what MSB3073 used to do).
    Log.LogError(
        subcategory: null,
        errorCode: code,
        helpKeyword: null,
        file: null,
        lineNumber: 0,
        columnNumber: 0,
        endLineNumber: 0,
        endColumnNumber: 0,
        message: "Orikago.Sdk: the command \"" + Command + "\" exited with code " +
        exitCode.ToString(CultureInfo.InvariantCulture) + ".");
}

if (Log.HasLoggedErrors)
{
    // A diagnostic was reported: fail the task - and therefore the target.
    // Written as an early-exit rather than a trailing "return" so that the
    // factory-generated "return !Log.HasLoggedErrors;" that follows this
    // fragment stays reachable (a trailing return here would make it dead code
    // and emit CS0162 on every build).
    return false;
}

]]></Code>
    </Task>
  </UsingTask>

</Project>
