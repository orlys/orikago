<?xml version="1.0" encoding="utf-8"?>
<!-- Orikago.Sdk / Sdk / Sdk.targets -->
<!-- Imported AFTER the user's project body. Imports the full Microsoft.NET.Sdk -->
<!-- target graph first, then overrides the compile/run/clean/test/publish surface -->
<!-- so that every verb drives the Go toolchain instead of Roslyn. -->
<!-- -->
<!-- Note on the target graph: for a .goproj, Microsoft.NET.Sdk falls back to -->
<!-- LanguageTargets = Microsoft.Common.targets, which references but does NOT -->
<!-- define CoreCompile and CreateManifestResourceNames. Both are defined below -->
<!-- (same class of override Microsoft.Build.NoTargets uses). -->
<Project>

  <!-- <GoExec>: Exec + a Go diagnostic parser that re-emits file/line/column -->
  <!-- through Log.LogError's structured overload, so go build / vet / test -->
  <!-- errors are navigable from the Visual Studio Error List. -->
  <Import Project="$(MSBuildThisFileDirectory)GoDiagnostics.targets" />

  <PropertyGroup>
    <!-- A c-shared library is nothing "dotnet run" can start. Set before the import, -->
    <!-- which derives more from OutputType. -->
    <OutputType Condition="'$(GoBuildMode)' == 'c-shared'">Library</OutputType>

    <!-- Microsoft.NET.Sdk only defaults LanguageTargets for .cs/.vb/.fsproj, and it -->
    <!-- imports the value immediately, so a .goproj must set it before that import. -->
    <LanguageTargets
        Condition="'$(LanguageTargets)' == '' And
                   '$(MSBuildProjectExtension)' != '.csproj' And
                   '$(MSBuildProjectExtension)' != '.vbproj' And
                   '$(MSBuildProjectExtension)' != '.fsproj'"
        >$(MSBuildToolsPath)\Microsoft.Common.targets</LanguageTargets>

    <!-- THE import Visual Studio's project system means by "critical imports": -->
    <!-- Microsoft.Managed.DesignTime.targets supplies the design-time build targets -->
    <!-- CPS calls when opening a project. The managed language targets bring it in -->
    <!-- for .csproj/.vbproj/.fsproj; a .goproj has to inject it itself, otherwise the -->
    <!-- project builds fine from the CLI but fails to open in Visual Studio. -->
    <!-- (Same technique as Microsoft.Build.NoTargets.) -->
    <_GoManagedDesignTimeTargets>$([System.String]::Concat(
        '$(MSBuildExtensionsPath)',
        '\Microsoft\VisualStudio\Managed',
        '\Microsoft.Managed.DesignTime.targets'))</_GoManagedDesignTimeTargets>
    <CustomBeforeMicrosoftCommonTargets
        Condition="'$(ManagedLanguageTargetsGotImported)' == '' And
                   Exists('$(_GoManagedDesignTimeTargets)')"
        >$(CustomBeforeMicrosoftCommonTargets);$(_GoManagedDesignTimeTargets)</CustomBeforeMicrosoftCommonTargets>
  </PropertyGroup>

  <Import Project="Sdk.targets"
          Sdk="Microsoft.NET.Sdk"
          Condition="'$(CommonTargetsPath)' == ''" />

  <!-- Microsoft.Managed.targets carries tasks that -->
  <!-- Microsoft.Common.CurrentVersion.targets expects; the managed language -->
  <!-- targets normally import it. -->
  <Import Project="$(MSBuildToolsPath)\Microsoft.Managed.targets"
          Condition="'$(MSBuildAssemblyVersion)' >= '16.0' And
                     '$(ManagedLanguageTargetsGotImported)' != 'true'" />

  <!-- Microsoft.Managed.DesignTime.targets adds PackageReferences whenever -->
  <!-- RestoreProjectStyle is PackageReference (which this SDK sets to keep -->
  <!-- restore quiet). That capability is what lights up NuGet's UI - 管理 -->
  <!-- NuGet 套件, the Packages node - and a Go module takes dependencies -->
  <!-- through go.mod (GoModuleReference), never NuGet, so it is removed -->
  <!-- here, AFTER the import that added it. Restore itself still runs; -->
  <!-- only the UI affordances go away. -->
  <ItemGroup>
    <ProjectCapability Remove="PackageReferences" />
    <!-- A Go module can reference neither .NET assemblies nor COM/WinRT -->
    <!-- components; removing these hides their Dependencies sub-nodes and -->
    <!-- "Add Reference" affordances. ProjectReferences stays - .goproj to -->
    <!-- .goproj references are supported (GetTargetPath glue above). -->
    <ProjectCapability Remove="AssemblyReferences" />
    <ProjectCapability Remove="COMReferences" />
    <ProjectCapability Remove="WinRTReferences" />
    <!-- LaunchProfiles stays: the managed project system's F5 plumbing (its -->
    <!-- IVsDebuggableProjectCfg) lives in that subsystem - removing the -->
    <!-- capability makes Debug.Start unavailable outright (verified). The -->
    <!-- delve hookup rides the pipeline instead: the VSIX exports an -->
    <!-- IDebugProfileLaunchTargetsProvider (GoDebugLaunchProvider), which is -->
    <!-- the extension point that pipeline actually consults per profile. -->
  </ItemGroup>

  <!-- ====================================================================== -->
  <!-- Static computed properties -->
  <!-- ====================================================================== -->
  <PropertyGroup>
    <_GoHostOS>linux</_GoHostOS>
    <_GoHostOS Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows</_GoHostOS>
    <_GoHostOS Condition="$([MSBuild]::IsOSPlatform('OSX'))">darwin</_GoHostOS>

    <!-- What to run instead of "go build" (a wrapper that compiles in a container, -->
    <!-- say). It receives the arguments after "go build" unchanged. -->
    <GoBuildCommand Condition="'$(GoBuildCommand)' == ''">go build</GoBuildCommand>

    <!-- Only the builds that produce a file take the build mode: "go vet" and "go -->
    <!-- test" never see it, because a test binary has to be an executable. -->
    <_GoBuildModeArg Condition="'$(GoBuildMode)' != ''">-buildmode=$(GoBuildMode)</_GoBuildModeArg>
    <_GoProducesFile Condition="'$(OutputType)' == 'Exe' Or '$(GoBuildMode)' == 'c-shared'"
      >true</_GoProducesFile>
    <_GoIsCShared Condition="'$(GoBuildMode)' == 'c-shared' Or
                             $(GoFlags.Contains('-buildmode=c-shared'))">true</_GoIsCShared>

    <!-- A Library build is a compile check. Without -o, "go build ./..." writes the -->
    <!-- binary of a lone main package into the source directory. -->
    <_GoNullDevice>/dev/null</_GoNullDevice>
    <_GoNullDevice Condition="'$(_GoHostOS)' == 'windows'">NUL</_GoNullDevice>

    <!-- File name of the product per target OS. -->
    <_GoFileNameOnWindows>$(AssemblyName).exe</_GoFileNameOnWindows>
    <_GoFileNameOnDarwin>$(AssemblyName)</_GoFileNameOnDarwin>
    <_GoFileNameElsewhere>$(AssemblyName)</_GoFileNameElsewhere>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GoBuildMode)' == 'c-shared'">
    <_GoFileNameOnWindows>$(AssemblyName).dll</_GoFileNameOnWindows>
    <_GoFileNameOnDarwin>lib$(AssemblyName).dylib</_GoFileNameOnDarwin>
    <_GoFileNameElsewhere>lib$(AssemblyName).so</_GoFileNameElsewhere>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Regular build: GOOS/GoArch may be set by the user; default is the host. -->
    <_GoBuildOS>$(GoOS)</_GoBuildOS>
    <_GoBuildOS Condition="'$(_GoBuildOS)' == ''">$(_GoHostOS)</_GoBuildOS>
    <_GoBuildFileName>$(_GoFileNameElsewhere)</_GoBuildFileName>
    <_GoBuildFileName Condition="'$(_GoBuildOS)' == 'windows'">$(_GoFileNameOnWindows)</_GoBuildFileName>
    <_GoBuildFileName Condition="'$(_GoBuildOS)' == 'darwin'">$(_GoFileNameOnDarwin)</_GoBuildFileName>
    <GoOutputPath Condition="'$(GoOutputPath)' == ''">$(TargetDir)$(_GoBuildFileName)</GoOutputPath>

    <!-- Marker written into obj/$(Configuration)/$(TargetFramework)/ so MSBuild -->
    <!-- incrementality has an output to compare against (Library builds produce -->
    <!-- no file at all; the others additionally compare the file itself). -->
    <_GoBuildStamp>$(IntermediateOutputPath)go.build.stamp</_GoBuildStamp>
    <_GoBuildOutputs>$(_GoBuildStamp)</_GoBuildOutputs>
    <_GoBuildOutputs Condition="'$(_GoProducesFile)' == 'true'"
        >$(_GoBuildStamp);$(GoOutputPath)</_GoBuildOutputs>
  </PropertyGroup>

  <!-- Re-point the managed output identity at the Go product. TargetFileName / -->
  <!-- TargetPath were computed from TargetExt=.dll during the import above, so they -->
  <!-- must be recomputed here - from GoOutputPath, which a project may override. This -->
  <!-- is the glue that makes GetTargetPath (and any ProjectReference to a .goproj) -->
  <!-- return the real build product. -->
  <PropertyGroup Condition="'$(_GoProducesFile)' == 'true'">
    <TargetPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(GoOutputPath)'))</TargetPath>
    <TargetFileName>$([System.IO.Path]::GetFileName('$(TargetPath)'))</TargetFileName>
    <TargetExt Condition="'$(OutputType)' == 'Exe' And '$(_GoBuildOS)' != 'windows'"></TargetExt>
  </PropertyGroup>

  <!-- A shared library or a compile check is nothing the referencing project can -->
  <!-- compile against, so a ProjectReference that forgets ReferenceOutputAssembly= -->
  <!-- "false" must not hand it to the compiler (CS0006 / CS0009). -->
  <!-- ResolveProjectReferences drops references that carry this metadata - and with -->
  <!-- them their copy, which is why an Exe, copied next to a referencing .goproj, -->
  <!-- does without. -->
  <ItemDefinitionGroup Condition="'$(OutputType)' != 'Exe'">
    <TargetPathWithTargetPlatformMoniker>
      <ResolveableAssembly>false</ResolveableAssembly>
    </TargetPathWithTargetPlatformMoniker>
  </ItemDefinitionGroup>

  <!-- dotnet run: execute the Go binary directly from the project directory. -->
  <!-- All three must be overridden: Microsoft.NET.Sdk already defaulted -->
  <!-- RunCommand=dotnet / RunArguments=exec "…dll" during the import above. -->
  <PropertyGroup Condition="'$(OutputType)' == 'Exe'">
    <RunCommand>$(GoOutputPath)</RunCommand>
    <RunArguments>$(StartArguments)</RunArguments>
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
  </PropertyGroup>

  <!-- RID -> GOOS/GOARCH map for dotnet publish -r <rid>. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <_GoRidOS Condition="$(RuntimeIdentifier.StartsWith('win-'))">windows</_GoRidOS>
    <_GoRidOS Condition="$(RuntimeIdentifier.StartsWith('linux-'))">linux</_GoRidOS>
    <_GoRidOS Condition="$(RuntimeIdentifier.StartsWith('osx-'))">darwin</_GoRidOS>
    <_GoRidArchitecture Condition="$(RuntimeIdentifier.EndsWith('-x64'))"
        >amd64</_GoRidArchitecture>
    <_GoRidArchitecture Condition="$(RuntimeIdentifier.EndsWith('-arm64'))"
        >arm64</_GoRidArchitecture>
  </PropertyGroup>

  <!-- Inputs for incremental builds. Evaluated statically; go.mod/go.sum are only -->
  <!-- added when they exist so a missing go.sum does not force perpetual rebuilds. -->
  <ItemGroup>
    <_GoBuildInput Include="@(GoCompile)" />
    <_GoBuildInput Include="@(GoNativeCompile)" />
    <_GoBuildInput Include="@(GoBuildInput)" />
    <_GoBuildInput Include="go.mod" Condition="Exists('$(MSBuildProjectDirectory)/go.mod')" />
    <_GoBuildInput Include="go.sum" Condition="Exists('$(MSBuildProjectDirectory)/go.sum')" />
    <_GoBuildInput Include="$(MSBuildProjectFullPath)" />
  </ItemGroup>

  <!-- Workspace builds resolve imports into SIBLING modules whose sources are -->
  <!-- not in @(_GoBuildInput) (the globs above are project-local by design), so -->
  <!-- after editing a sibling library - or adding a replace directive to -->
  <!-- go.work - a timestamp comparison would skip GoBuild and silently reuse a -->
  <!-- stale binary. When a go.work governs this project, opt out of the -->
  <!-- up-to-date skip by listing an input that never exists: MSBuild treats a -->
  <!-- missing input as out-of-date, so go build always runs, and go's own -->
  <!-- build cache keeps the no-change case down to one cheap process launch. -->
  <!-- The probe mirrors GoEnsureWorkspace's: GOWORK wins, else the nearest -->
  <!-- go.work above the project. -->
  <!-- ponytail: blanket always-build under go.work; enumerate sibling module -->
  <!-- sources as real inputs if that process launch ever matters. -->
  <PropertyGroup>
    <_GoWorkStaticProbe Condition="'$(GOWORK)' != ''">$(GOWORK)</_GoWorkStaticProbe>
    <_GoWorkStaticProbe Condition="'$(GOWORK)' == ''">$([MSBuild]::GetPathOfFileAbove(
        'go.work',
        '$(MSBuildProjectDirectory)'))</_GoWorkStaticProbe>
  </PropertyGroup>
  <ItemGroup>
    <_GoBuildInput Include="$(IntermediateOutputPath)go.workspace.always-out-of-date"
                   Condition="'$(_GoWorkStaticProbe)' != '' And
                              '$(_GoWorkStaticProbe)' != 'off'" />
  </ItemGroup>

  <!-- ====================================================================== -->
  <!-- Module bootstrap: go.mod existence + LangVersion -> go directive. -->
  <!-- The go directive is the real LangVersion semantic: the Go toolchain -->
  <!-- gates language features on it (e.g. generics need go >= 1.18). -->
  <!-- ====================================================================== -->
  <Target Name="GoEnsureMod" Condition="'$(DesignTimeBuild)' != 'true'">
    <!-- GoExec, not Exec: a failure here (e.g. a GoModuleName override that go -->
    <!-- still rejects) must surface as a structured GOMOD error, not as an -->
    <!-- MSB3073 pointing at this file inside the NuGet cache. -->
    <GoExec Command="go mod init &quot;$(GoModuleName)&quot;"
            Condition="!Exists('$(MSBuildProjectDirectory)/go.mod')"
            WorkingDirectory="$(MSBuildProjectDirectory)"
            ErrorCode="GOMOD" />
    <!-- "go mod edit" rewrites go.mod even when nothing changes, which would make -->
    <!-- go.mod perpetually newer than the build stamp and defeat incremental -->
    <!-- builds - so only run it when the directive actually differs. -->
    <!-- GOTOOLCHAIN=local: editing go.mod must never require the toolchain the -->
    <!-- file currently demands, or downgrading LangVersion wedges when go.mod -->
    <!-- points at a Go newer than the one installed. -->
    <GoExec Command="go mod edit -go=$(LangVersion)"
            Condition="'$(LangVersion)' != '' And
                       Exists('$(MSBuildProjectDirectory)/go.mod') And
                       !$([System.Text.RegularExpressions.Regex]::IsMatch(
                           $([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/go.mod')),
                           '(?m)^go\s+$(LangVersion)\s*$'))"
            WorkingDirectory="$(MSBuildProjectDirectory)"
            EnvironmentVariables="GOTOOLCHAIN=local"
            ErrorCode="GOMOD" />
  </Target>

  <!-- ====================================================================== -->
  <!-- Module references: -->
  <!--   <GoModuleReference Include="module/path" Version="vX.Y.Z" /> -->
  <!-- is the PackageReference of the Go world - each one is materialized with -->
  <!-- "go get module@version", which resolves the module, records it in go.mod -->
  <!-- and fills go.sum. Version omitted means latest. -->
  <!-- -->
  <!-- Idempotence follows the same rule as "go mod edit -go" above: "go get" -->
  <!-- rewrites go.mod/go.sum even when nothing changes, which would defeat the -->
  <!-- incremental build, so each reference only runs when go.mod does not -->
  <!-- already require that module (at that version, when one is pinned). -->
  <!-- Changing Version in the project therefore re-runs it. -->
  <!-- -->
  <!-- "go get" leaves the hashes of the previous version in go.sum, so a build that -->
  <!-- ran it also runs "go mod tidy". Tidy drops what no source file imports, which -->
  <!-- includes a reference declared ahead of the code that will use it: those are -->
  <!-- resolved once more, or every later build would start over. Tidy only follows -->
  <!-- a "go get" that changed go.mod: a Version such as "latest" or "v1.6" never -->
  <!-- matches a require and is queried by every build. GoModTidy=false turns it off. -->
  <!-- ====================================================================== -->
  <Target Name="GoRestoreModules"
          Condition="'$(DesignTimeBuild)' != 'true' And '@(GoModuleReference)' != ''"
          DependsOnTargets="GoEnsureMod">
    <ItemGroup>
      <!-- %(GoModuleReference.Version), never %(Version): the unqualified form is an -->
      <!-- error as soon as one reference has no Version. -->
      <_GoModule Include="@(GoModuleReference)">
        <Query>%(Identity)</Query>
        <Query Condition="'%(GoModuleReference.Version)' != ''"
          >%(Identity)@%(GoModuleReference.Version)</Query>
        <VersionPattern>v</VersionPattern>
        <VersionPattern Condition="'%(GoModuleReference.Version)' != ''"
          >$([System.Text.RegularExpressions.Regex]::Escape(
            '%(GoModuleReference.Version)'))(\s|$)</VersionPattern>
      </_GoModule>
      <_GoModule>
        <RequirePattern>$([System.String]::Concat(
          '(?m)^[ \t]*(require[ \t]+)?',
          $([System.Text.RegularExpressions.Regex]::Escape('%(Identity)')),
          '[ \t]+',
          '%(VersionPattern)'))</RequirePattern>
      </_GoModule>

      <_GoModuleToGet Include="@(_GoModule)"
                      Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch(
                          $([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/go.mod')),
                          '%(RequirePattern)'))" />
    </ItemGroup>
    <PropertyGroup>
      <_GoModBeforeGet>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/go.mod'))</_GoModBeforeGet>
    </PropertyGroup>
    <GoExec Command="go get &quot;%(_GoModuleToGet.Query)&quot;"
            Condition="'@(_GoModuleToGet)' != ''"
            WorkingDirectory="$(MSBuildProjectDirectory)"
            EnvironmentVariables="$(GoEnvironment)"
            ErrorCode="GOGET" />
    <PropertyGroup>
      <_GoModAfterGet>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/go.mod'))</_GoModAfterGet>
      <_GoModNeedsTidy Condition="'$(GoModTidy)' != 'false' And
                                  '$(_GoModBeforeGet)' != '$(_GoModAfterGet)'">true</_GoModNeedsTidy>
    </PropertyGroup>

    <!-- Only a warning: tidy resolves the imports of every build tag and of every -->
    <!-- dependency's tests, so it can fail on a module that builds fine. -->
    <GoExec Command="go mod tidy"
            Condition="'$(_GoModNeedsTidy)' == 'true'"
            WorkingDirectory="$(MSBuildProjectDirectory)"
            EnvironmentVariables="$(GoEnvironment)"
            ErrorCode="GOTIDY"
            ContinueOnError="WarnAndContinue" />
    <ItemGroup Condition="'$(_GoModNeedsTidy)' == 'true'">
      <_GoModuleTidiedAway Include="@(_GoModule)"
                           Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch(
                               $([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/go.mod')),
                               '%(RequirePattern)'))" />
    </ItemGroup>
    <GoExec Command="go get &quot;%(_GoModuleTidiedAway.Query)&quot;"
            Condition="'@(_GoModuleTidiedAway)' != ''"
            WorkingDirectory="$(MSBuildProjectDirectory)"
            EnvironmentVariables="$(GoEnvironment)"
            ErrorCode="GOGET" />
  </Target>

  <!-- ====================================================================== -->
  <!-- Workspace bootstrap: go.work membership. -->
  <!-- -->
  <!-- GOWORK is inherited by every subdirectory, so a module created anywhere -->
  <!-- underneath a directory that already owns a go.work is INSIDE the -->
  <!-- workspace but is not a MEMBER of it until go.work's "use" block lists -->
  <!-- it - and the toolchain then refuses to build it outright: -->
  <!--   main module (x) does not contain package x/<newmodule> -->
  <!-- That is exactly what the New Project flow produces, so the module is -->
  <!-- registered here, right after it has been given a go.mod. -->
  <!-- -->
  <!-- Opt out per project with <GoEnsureWorkspaceMembership>false</...> (for a -->
  <!-- module that is deliberately kept out of the workspace). -->
  <!-- -->
  <!-- One go.work is shared by every module under it, so a parallel solution -->
  <!-- build (/m) runs this target in several processes at once against the SAME -->
  <!-- file. Read-decide-write must therefore be atomic across processes, which -->
  <!-- is what <GoWorkUse> below provides; see its comment for why. -->
  <!-- ====================================================================== -->

  <!-- <GoWorkUse>: "go work use <path>", serialized across processes. -->
  <!-- -->
  <!-- The race it closes: with N .goproj projects sharing one go.work, MSBuild's -->
  <!-- /m gives each project its own node process. Each independently reads -->
  <!-- go.work, sees its own module missing, and runs "go work use". "go work -->
  <!-- use" is read-modify-write on the whole file, so two of them overlapping -->
  <!-- produce a last-writer-wins result that silently drops the other module - -->
  <!-- or, if the reader catches the writer mid-flight, a truncated go.work. -->
  <!-- Neither is recoverable by a rebuild: the next build reads the damaged -->
  <!-- file and "fixes" only its own entry. -->
  <!-- -->
  <!-- The lock is a named system Mutex, i.e. a kernel object, because the -->
  <!-- contenders are separate processes (an in-process lock would not see them) -->
  <!-- and because the OS releases it if a build is killed mid-write. It is -->
  <!-- named after the go.work path so that builds of unrelated workspaces never -->
  <!-- queue behind each other. -->
  <!-- -->
  <!-- Membership is re-checked INSIDE the lock. That is the actual fix: the -->
  <!-- "module missing" observation that got us here was made before the lock, -->
  <!-- so by the time we own it a sibling may already have added us, and the -->
  <!-- correct action is then to do nothing. -->
  <!-- -->
  <!-- Inline task via RoslynCodeTaskFactory for the same reason GoExec is one -->
  <!-- (see GoDiagnostics.targets): it is the only factory that runs under both -->
  <!-- "dotnet build" and Visual Studio's MSBuild.exe, so the SDK still ships -->
  <!-- nothing but MSBuild logic. -->
  <UsingTask TaskName="GoWorkUse"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <!-- Full path of the go.work in effect (already resolved by "go env GOWORK"). -->
      <GoWorkFile ParameterType="System.String" Required="true" />
      <!-- Directory holding it; "go work use" is run from here so the recorded -->
      <!-- entry stays relative. -->
      <WorkspaceDirectory ParameterType="System.String" Required="true" />
      <!-- The argument for "go work use", relative to WorkspaceDirectory. -->
      <UsePath ParameterType="System.String" Required="true" />
      <!-- Regex proving membership; built in GoEnsureWorkspace so the pattern -->
      <!-- has exactly one definition. -->
      <UsePattern ParameterType="System.String" Required="true" />
      <LockTimeoutSeconds ParameterType="System.Int32" />
      <!-- True only when this invocation actually wrote to go.work. -->
      <Added ParameterType="System.Boolean" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Diagnostics" />
      <Using Namespace="System.Globalization" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="System.Threading" />
      <Code Type="Fragment" Language="cs"><![CDATA[
#nullable enable

Added = false;

var workFile = GoWorkFile;
try
{
    workFile = Path.GetFullPath(GoWorkFile);
}
catch (Exception exception)
{
    // The path cannot be normalized: use it exactly as it was passed.
    Log.LogMessage(
        importance: MessageImportance.Low,
        message: "Orikago.Sdk: could not normalize \"" + GoWorkFile + "\" (" +
        exception.Message + ").");
}

// Scope the lock to this go.work. FNV-1a rather than a crypto hash: the name
// only has to be stable and well distributed - a collision would merely make
// two unrelated workspaces share one lock, which costs a little serialization
// and breaks nothing - and it needs no assembly reference beyond mscorlib,
// which keeps the inline task compiling identically under MSBuild.exe and
// "dotnet build". Windows paths are case-insensitive, so fold case there or the
// same file reached by two spellings would take two different locks.
const ulong FNV_OFFSET_BASIS = 14695981039346656037UL;
const ulong FNV_PRIME = 1099511628211UL;
var key = (Path.DirectorySeparatorChar == '\\') ? workFile.ToUpperInvariant() : workFile;
var hash = FNV_OFFSET_BASIS;
foreach (var character in key)
{
    hash ^= (ulong)character;
    hash *= FNV_PRIME;
}
var lockName = "Orikago.GoWork." + hash.ToString("x16", CultureInfo.InvariantCulture);

const int DEFAULT_LOCK_TIMEOUT_SECONDS = 120;
var timeoutSeconds = (LockTimeoutSeconds > 0)
    ? LockTimeoutSeconds
    : DEFAULT_LOCK_TIMEOUT_SECONDS;

// "Global\": the contenders can live in different logon sessions (a VS build
// and a CLI build, or a build service). Creating a Global kernel object needs
// SeCreateGlobalPrivilege, which a plain interactive account may not hold, so
// degrade to the session-local namespace, and finally to no lock at all -
// which is exactly the unsynchronized behaviour this task replaces, never
// worse.
var mutex = default(Mutex);
try
{
    mutex = new Mutex(false, "Global\\" + lockName, out _);
}
catch (Exception exception)
{
    // No Global kernel object for this account: try the session namespace next.
    Log.LogMessage(
        importance: MessageImportance.Low,
        message: "Orikago.Sdk: no Global lock for \"" + workFile + "\" (" +
        exception.Message + ").");
}
if (mutex is null)
{
    try
    {
        mutex = new Mutex(false, "Local\\" + lockName, out _);
    }
    catch (Exception exception)
    {
        // No session-local kernel object either.
        Log.LogMessage(
            importance: MessageImportance.Low,
            message: "Orikago.Sdk: no Local lock for \"" + workFile + "\" (" +
            exception.Message + ").");
    }
}
if (mutex is null)
{
    // Neither namespace is available: proceed exactly as an unsynchronized build would.
    Log.LogMessage(
        importance: MessageImportance.Low,
        message: "Orikago.Sdk: no cross-process lock available for \"" + workFile +
        "\"; proceeding unsynchronized.");
}

var held = default(bool);
try
{
    if (mutex is not null)
    {
        try
        {
            held = mutex.WaitOne(TimeSpan.FromSeconds(timeoutSeconds));
        }
        catch (AbandonedMutexException)
        {
            // A previous owner exited without releasing (build killed mid-write).
            // WaitOne still transferred ownership to us, so we DO hold it. The
            // in-lock re-read below is what makes the half-finished predecessor
            // harmless: we look at the file as it actually is now.
            held = true;
        }
        if (!held)
        {
            // The lock stayed busy for the whole timeout: go ahead without it.
            Log.LogMessage(
                importance: MessageImportance.Normal,
                message: "Orikago.Sdk: timed out after " +
                timeoutSeconds.ToString(CultureInfo.InvariantCulture) +
                "s waiting for the \"" + workFile +
                "\" workspace lock; proceeding without it.");
        }
    }

    // Re-check membership under the lock. FileShare.ReadWrite|Delete: a sibling
    // may legitimately be rewriting go.work when the lock could not be taken,
    // and a sharing violation here must not fail the build.
    var isMember = default(bool);
    try
    {
        using var stream = new FileStream(
            path: workFile,
            mode: FileMode.Open,
            access: FileAccess.Read,
            share: FileShare.ReadWrite | FileShare.Delete);
        using var reader = new StreamReader(
            stream: stream,
            encoding: new UTF8Encoding(false),
            detectEncodingFromByteOrderMarks: true);
        var text = reader.ReadToEnd();
        isMember = Regex.IsMatch(text, UsePattern, RegexOptions.CultureInvariant);
    }
    catch (Exception exception)
    {
        // Unreadable go.work: fall through and let "go work use" decide. It
        // rewrites an existing entry in place rather than duplicating it, so a
        // false negative here is safe.
        Log.LogMessage(
            importance: MessageImportance.Low,
            message: "Orikago.Sdk: could not test membership in \"" + workFile + "\" (" +
            exception.Message + "); running \"go work use\" anyway.");
    }

    if (isMember)
    {
        // Idempotent: leave go.work's mtime alone so it does not thrash the
        // incremental build of every module in the workspace.
        Log.LogMessage(
            importance: MessageImportance.Low,
            message: "Orikago.Sdk: \"" + UsePath + "\" is already used by \"" +
            workFile + "\".");
        return !Log.HasLoggedErrors;
    }

    // Not a member yet: run "go work use" from the workspace directory.
    // Deliberately NOT GOTOOLCHAIN=local: "go work use" LOADS the added
    // module's go.mod, so a module whose go directive is newer than the
    // installed toolchain (a langVersion the templates offer) would fail
    // with "requires go >= X" and could never join the workspace. The
    // default (auto) downloads the required toolchain, same as GoBuild.
    var startInfo = new ProcessStartInfo();
    startInfo.FileName = "go";
    startInfo.Arguments = "work use \"" + UsePath + "\"";
    startInfo.WorkingDirectory = WorkspaceDirectory;
    startInfo.UseShellExecute = false;
    startInfo.CreateNoWindow = true;
    startInfo.RedirectStandardOutput = true;
    startInfo.RedirectStandardError = true;

    var output = new StringBuilder();
    var exitCode = -1;
    try
    {
        using var process = new Process();
        process.StartInfo = startInfo;
        process.OutputDataReceived += (sender, e) =>
        {
            if (e.Data is not null)
            {
                lock (output)
                {
                    output.AppendLine(e.Data);
                }
            }
        };
        process.ErrorDataReceived += (sender, e) =>
        {
            if (e.Data is not null)
            {
                lock (output)
                {
                    output.AppendLine(e.Data);
                }
            }
        };
        process.Start();
        process.BeginOutputReadLine();
        process.BeginErrorReadLine();
        process.WaitForExit();
        exitCode = process.ExitCode;
    }
    catch (Exception exception)
    {
        // The go command could not be run at all.
        Log.LogError(
            "Orikago.Sdk: failed to run \"go work use " + UsePath + "\" in \"" +
            WorkspaceDirectory + "\": " + exception.Message);
        return false;
    }

    var outputText = output.ToString().TrimEnd();
    if (outputText is { Length: > 0 })
    {
        Log.LogMessage(MessageImportance.Normal, outputText);
    }

    if (exitCode != 0)
    {
        // "go work use" rejected the module: go.work was not changed.
        Log.LogError(
            "Orikago.Sdk: \"go work use " + UsePath + "\" in \"" + WorkspaceDirectory +
            "\" exited with code " + exitCode.ToString(CultureInfo.InvariantCulture) +
            ((outputText is { Length: > 0 }) ? ": " + outputText : "."));
        return false;
    }

    Added = true;
}
finally
{
    if (mutex is not null)
    {
        if (held)
        {
            try
            {
                mutex.ReleaseMutex();
            }
            catch (Exception exception)
            {
                // Releasing failed; the handle is still disposed below.
                Log.LogMessage(
                    importance: MessageImportance.Low,
                    message: "Orikago.Sdk: could not release the \"" + workFile +
                    "\" workspace lock (" + exception.Message + ").");
            }
        }
        mutex.Dispose();
    }
}

]]></Code>
    </Task>
  </UsingTask>
  <Target Name="GoEnsureWorkspace"
          Condition="'$(DesignTimeBuild)' != 'true' And
                     '$(GoEnsureWorkspaceMembership)' != 'false'"
          DependsOnTargets="GoEnsureMod">

    <!-- Cheap and exact pre-guard, so the common "no workspace at all" case -->
    <!-- costs nothing. The go command resolves GOWORK from the environment -->
    <!-- variable when it is set - it cannot come from anywhere else, "go env -->
    <!-- -w GOWORK=..." answers "go: GOWORK cannot be modified" - and otherwise -->
    <!-- by walking up from the working directory looking for go.work. If -->
    <!-- neither yields anything there is definitively no workspace, so skip -->
    <!-- the process launch instead of paying for it on every build. -->
    <PropertyGroup>
      <_GoWorkProbe Condition="'$(GOWORK)' != ''">$(GOWORK)</_GoWorkProbe>
      <_GoWorkProbe Condition="'$(GOWORK)' == ''">$([MSBuild]::GetPathOfFileAbove(
        'go.work',
        '$(MSBuildProjectDirectory)'))</_GoWorkProbe>
    </PropertyGroup>

    <!-- Authoritative value: let the toolchain itself say which go.work is in -->
    <!-- effect rather than trusting the reimplementation above. -->
    <Exec Condition="'$(_GoWorkProbe)' != '' And '$(_GoWorkProbe)' != 'off'"
          Command="go env GOWORK"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          EnvironmentVariables="$(GoEnvironment);GOTOOLCHAIN=local"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GoWorkFile" />
    </Exec>

    <PropertyGroup>
      <_GoWorkFile>$(_GoWorkFile.Trim())</_GoWorkFile>
      <_GoWorkFile Condition="'$(_GoWorkFile)' == 'off' Or
                              !Exists('$(_GoWorkFile)')"></_GoWorkFile>
      <_GoWorkDirectory Condition="'$(_GoWorkFile)' != ''"
        >$([System.IO.Path]::GetDirectoryName('$(_GoWorkFile)'))</_GoWorkDirectory>

      <!-- go.work spells its use paths relative to itself, with forward -->
      <!-- slashes. MakeRelative returns "." when the project dir IS the -->
      <!-- workspace dir, which is also how go.work spells that entry. -->
      <_GoWorkRelativePath Condition="'$(_GoWorkDirectory)' != ''">$([MSBuild]::MakeRelative(
        '$(_GoWorkDirectory)',
        '$(MSBuildProjectDirectory)').Replace('\', '/').TrimEnd('/'))</_GoWorkRelativePath>
      <_GoWorkRelativePath
          Condition="'$(_GoWorkDirectory)' != '' And '$(_GoWorkRelativePath)' == ''"
          >.</_GoWorkRelativePath>

      <!-- Matches the entry in either shape go.work accepts - inside a "use ( -->
      <!-- ... )" block or on a single "use <path>" line - with the optional -->
      <!-- "./" prefix and the quoting go adds for paths containing spaces. -->
      <!-- An absolute entry (what "go work use <absolute-path>" leaves behind, -->
      <!-- and what a hand-written go.work may contain) counts as membership -->
      <!-- too, so both slash flavours are accepted. Regex.Escape is what keeps -->
      <!-- a path such as "v1.2" from turning its dots into wildcards. -->
      <_GoWorkUsePattern Condition="'$(_GoWorkRelativePath)' != ''">$([System.String]::Concat(
        '(?m)^[ \t]*(use[ \t]+)?"?((\./)?',
        $([System.Text.RegularExpressions.Regex]::Escape('$(_GoWorkRelativePath)')),
        '|',
        $([System.Text.RegularExpressions.Regex]::Escape('$(MSBuildProjectDirectory)')),
        '|',
        $([System.Text.RegularExpressions.Regex]::Escape(
          '$(MSBuildProjectDirectory.Replace('\', '/'))')),
        ')"?[ \t]*$'))</_GoWorkUsePattern>
    </PropertyGroup>

    <!-- The membership test that used to live here - a Regex.IsMatch over -->
    <!-- File.ReadAllText - now runs inside GoWorkUse instead. It has to: a -->
    <!-- decision taken during evaluation is already stale by the time the write -->
    <!-- happens, which is precisely the race being fixed. Testing it twice would -->
    <!-- also open a second, unsynchronized read window onto a file a sibling -->
    <!-- build may be rewriting. -->
    <!-- -->
    <!-- The RELATIVE path is passed deliberately: "go work use" records the -->
    <!-- argument as given, so handing it an absolute path bakes a machine -->
    <!-- specific (and, on Windows, backslash-separated) entry into a file that -->
    <!-- is normally committed. Run from the workspace directory, the relative -->
    <!-- form lands as the canonical "./<path>" that go itself writes. -->
    <GoWorkUse Condition="'$(_GoWorkDirectory)' != '' And
                          Exists('$(MSBuildProjectDirectory)/go.mod')"
               GoWorkFile="$(_GoWorkFile)"
               WorkspaceDirectory="$(_GoWorkDirectory)"
               UsePath="$(_GoWorkRelativePath)"
               UsePattern="$(_GoWorkUsePattern)">
      <Output TaskParameter="Added" PropertyName="_GoWorkAdded" />
    </GoWorkUse>

    <Message Importance="normal"
             Condition="'$(_GoWorkAdded)' == 'true'"
             Text="$(MSBuildProjectName) -&gt; added &quot;$(_GoWorkRelativePath)&quot; to $(_GoWorkFile)" />
  </Target>

  <!-- ====================================================================== -->
  <!-- Shared argument/environment computation for build, vet and test. -->
  <!-- ====================================================================== -->
  <Target Name="GoPrepareBuildSettings">
    <Error Condition="'$(GoBuildMode)' != '' And '$(GoBuildMode)' != 'c-shared'"
           Text="$([System.String]::Concat(
                 `Orikago.Sdk: GoBuildMode '$(GoBuildMode)' is not supported, only c-shared is. `,
                 `Set -buildmode in GoFlags and the output file in GoOutputPath instead.`))" />

    <!-- The file name follows the target, which is only known from the properties. -->
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch(
                          '$(GoEnvironment)',
                          '(?i)(^|;)\s*GO(OS|ARCH)\s*='))"
           Text="Orikago.Sdk: set GoOS / GoArch instead of GOOS / GOARCH in GoEnvironment." />

    <!-- A property rather than items: an item list would expand the wildcards in a -->
    <!-- value such as CGO_LDFLAGS. The dedicated properties come last and win. -->
    <PropertyGroup>
      <_GoEnvironment>$(GoEnvironment)</_GoEnvironment>
      <_GoEnvironment Condition="'$(GoOS)' != ''">$(_GoEnvironment);GOOS=$(GoOS)</_GoEnvironment>
      <_GoEnvironment Condition="'$(GoArch)' != ''">$(_GoEnvironment);GOARCH=$(GoArch)</_GoEnvironment>
      <_GoEnvironment Condition="'$(GoToolchain)' != ''"
        >$(_GoEnvironment);GOTOOLCHAIN=$(GoToolchain)</_GoEnvironment>
    </PropertyGroup>

    <!-- The effective toolchain version participates in the up-to-date check: -->
    <!-- GOTOOLCHAIN can change (go env -w, env var) without touching any -->
    <!-- input file, and a binary built by the previous toolchain would -->
    <!-- otherwise be silently reused. -->
    <Exec Command="go version"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GoToolchainVersion" />
    </Exec>

    <ItemGroup>
      <!-- Item-splitting on $(DefineConstants) drops empty entries, so -->
      <!-- "FOO;;BAR;" still yields clean "-tags FOO,BAR". -->
      <_GoDefineConstant Include="$(DefineConstants)" />
    </ItemGroup>
    <PropertyGroup>
      <_GoTags>@(_GoDefineConstant, ',')</_GoTags>
      <!-- Escaped semicolons (%3B on the command line) survive item splitting; -->
      <!-- normalize them to commas as well. -->
      <_GoTags>$(_GoTags.Replace(';', ','))</_GoTags>

      <_GoBuildArgs Condition="'$(Configuration)' == 'Release'"
        >-trimpath -ldflags "-s -w"</_GoBuildArgs>
      <!-- Optimize: the switch a C# project would use, false in Debug by default. -->
      <_GoBuildArgs Condition="'$(Configuration)' == 'Debug' And '$(Optimize)' != 'true'"
        >-gcflags "all=-N -l"</_GoBuildArgs>
      <_GoBuildArgs Condition="'$(_GoTags)' != ''"
        >$(_GoBuildArgs) -tags "$(_GoTags)"</_GoBuildArgs>
      <_GoBuildArgs Condition="'$(GoFlags)' != ''">$(_GoBuildArgs) $(GoFlags)</_GoBuildArgs>

      <!-- A -buildmode in GoFlags that yields no executable would leave "go test" with -->
      <!-- a test binary the OS cannot start; the last -buildmode wins. -->
      <_GoTestArgs>$(_GoBuildArgs)</_GoTestArgs>
      <_GoTestArgs Condition="$([System.Text.RegularExpressions.Regex]::IsMatch(
                                  '$(GoFlags)',
                                  '-buildmode[= ](?!default|exe|pie)'))"
        >$(_GoTestArgs) -buildmode=default</_GoTestArgs>
    </PropertyGroup>

    <!-- Persist the effective arguments/environment so flag-only changes -->
    <!-- (e.g. a different DefineConstants -> -tags) invalidate GoBuild's -->
    <!-- up-to-date check; without this a stale binary is silently reused. -->
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(IntermediateOutputPath)go.build.args"
                      Lines="$(GoBuildCommand);
                             $(_GoBuildArgs);
                             $(_GoBuildModeArg);
                             $(_GoEnvironment);
                             $(_GoToolchainVersion)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <!-- Persist the input SET as well. Inputs/Outputs only compare timestamps of -->
    <!-- files that still exist, so DELETING a source file would otherwise leave a -->
    <!-- stale binary: the file vanishes from Inputs and nothing looks out of date. -->
    <!-- Rewriting this list on any set change makes it newer than the output. -->
    <WriteLinesToFile File="$(IntermediateOutputPath)go.build.inputs"
                      Lines="@(_GoBuildInput->'%(FullPath)')"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <_GoBuildInput Include="$(IntermediateOutputPath)go.build.args" />
      <_GoBuildInput Include="$(IntermediateOutputPath)go.build.inputs" />
    </ItemGroup>
  </Target>

  <!-- ====================================================================== -->
  <!-- Build -->
  <!-- ====================================================================== -->
  <Target Name="GoBuild"
          Condition="'$(DesignTimeBuild)' != 'true'"
          DependsOnTargets="GoEnsureMod;
                            GoEnsureWorkspace;
                            GoRestoreModules;
                            GoPrepareBuildSettings"
          Inputs="@(_GoBuildInput)"
          Outputs="$(_GoBuildOutputs)">
    <MakeDir Directories="$(TargetDir);$(IntermediateOutputPath)" />

    <!-- GoExec, not Exec: the compiler's "file:line:col: message" lines are -->
    <!-- re-logged with real file/line/column so they are navigable from the -->
    <!-- Error List. See GoDiagnostics.targets. -->
    <GoExec Condition="'$(_GoProducesFile)' == 'true'"
            Command="$(GoBuildCommand) $(_GoBuildArgs) $(_GoBuildModeArg) -o &quot;$(GoOutputPath)&quot; ."
            WorkingDirectory="$(MSBuildProjectDirectory)"
            EnvironmentVariables="$(_GoEnvironment)"
            ErrorCode="GOBUILD" />

    <!-- Library: compile-check the whole module, no artifact (unless GoFlags asks for -->
    <!-- one: the last -o wins). -->
    <GoExec Condition="'$(_GoProducesFile)' != 'true'"
            Command="$(GoBuildCommand) -o $(_GoNullDevice) $(_GoBuildArgs) ./..."
            WorkingDirectory="$(MSBuildProjectDirectory)"
            EnvironmentVariables="$(_GoEnvironment)"
            ErrorCode="GOBUILD" />

    <Touch Files="$(_GoBuildStamp)" AlwaysCreate="true" />
    <Message Importance="High"
             Text="$(MSBuildProjectName) -&gt; $(GoOutputPath)"
             Condition="'$(_GoProducesFile)' == 'true'" />

    <OnError ExecuteTargets="_GoExplainDisabledCgo" />
  </Target>

  <!-- Runs only after a failed go build. c-shared needs cgo, which Go switches off -->
  <!-- when cross-compiling (or when it finds no C compiler); its own message names -->
  <!-- neither variable that turns it back on. A custom GoBuildCommand may run on -->
  <!-- another machine, about which the local "go env" says nothing. Without a -->
  <!-- toolchain version, a dependency of the target failed, not go build. -->
  <Target Name="_GoExplainDisabledCgo"
          Condition="'$(_GoIsCShared)' == 'true' And
                     '$(GoBuildCommand)' == 'go build' And
                     '$(_GoToolchainVersion)' != ''">
    <PropertyGroup>
      <_GoFailedEnvironment>$(_GoPublishEnvironment)</_GoFailedEnvironment>
      <_GoFailedEnvironment Condition="'$(_GoFailedEnvironment)' == ''">$(_GoEnvironment)</_GoFailedEnvironment>
    </PropertyGroup>
    <Exec Command="go env CGO_ENABLED"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          EnvironmentVariables="$(_GoFailedEnvironment)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GoCgoEnabled" />
    </Exec>
    <Error Condition="'$(_GoCgoEnabled)' == '0'"
           Code="GOCGO"
           Text="$([System.String]::Concat(
                 `Orikago.Sdk: c-shared needs cgo, and cgo is off for this target: Go turns it off `,
                 `when cross-compiling or when it finds no C compiler. Set GoEnvironment to `,
                 `CGO_ENABLED=1%3BCC=&lt;C compiler for the target&gt;.`))" />
  </Target>

  <!-- CoreCompile is referenced by Microsoft.Common's CompileDependsOn but (like -->
  <!-- CreateManifestResourceNames) is normally defined by language targets that a -->
  <!-- .goproj never imports. Defining them here both completes the target graph -->
  <!-- and guarantees Roslyn never runs. -->
  <Target Name="CoreCompile" DependsOnTargets="GoBuild" />
  <Target Name="CreateManifestResourceNames" />

  <!-- Optional lint pass: dotnet build -p:RunGoVet=true -->
  <Target Name="GoVet"
          AfterTargets="GoBuild"
          Condition="'$(RunGoVet)' == 'true' And '$(DesignTimeBuild)' != 'true'"
          DependsOnTargets="GoPrepareBuildSettings">
    <!-- $(_GoBuildArgs) rides along ("go vet" accepts build flags): vet must see -->
    <!-- the same build context - tags, GoFlags - that GoBuild just compiled, or -->
    <!-- it analyses a different file set than the one that was built. -->
    <!-- -->
    <!-- One run per GoVetTagSet item, whose Tags replace DefineConstants (the last -->
    <!-- -tags wins): <GoVetTagSet Include="label" Tags="a;b" />. Without any, one run. -->
    <!-- A failing set does not keep the others from being reported. -->
    <PropertyGroup>
      <_GoVetOnFailure>ErrorAndStop</_GoVetOnFailure>
      <_GoVetOnFailure Condition="'@(GoVetTagSet)' != ''">ErrorAndContinue</_GoVetOnFailure>
    </PropertyGroup>
    <ItemGroup>
      <_GoVetRun Include="@(GoVetTagSet)">
        <TagsArg>-tags "$([System.Text.RegularExpressions.Regex]::Replace(
          '%(GoVetTagSet.Tags)',
          '[;\s]+',
          ',').Trim(','))"</TagsArg>
      </_GoVetRun>
      <_GoVetRun Include="default" Condition="'@(GoVetTagSet)' == ''" />
    </ItemGroup>
    <GoExec Command="go vet $(_GoBuildArgs) %(_GoVetRun.TagsArg) ./..."
            WorkingDirectory="$(MSBuildProjectDirectory)"
            EnvironmentVariables="$(_GoEnvironment)"
            ErrorCode="GOVET"
            ContinueOnError="$(_GoVetOnFailure)">
      <Output TaskParameter="ExitCode" ItemName="_GoVetExitCode" />
    </GoExec>
    <!-- Fails the target, or the projects that reference this one would go on. -->
    <Error Condition="'@(_GoVetExitCode->Distinct())' != '0'"
           Code="GOVET"
           Text="Orikago.Sdk: go vet failed for at least one GoVetTagSet." />
  </Target>

  <!-- Optional formatting check: dotnet build -p:RunGoFmt=true -->
  <!-- "gofmt -l ." also walks vendor, bin, obj and what "./..." ignores, so its answer -->
  <!-- is narrowed down to the project's own sources. -->
  <!-- ponytail: the gofmt on PATH, not that of a toolchain picked by GOTOOLCHAIN. -->
  <Target Name="GoFmt"
          AfterTargets="GoBuild"
          Condition="'$(RunGoFmt)' == 'true' And '$(DesignTimeBuild)' != 'true'">
    <!-- The encoding: gofmt prints UTF-8, which MSBuild.exe would read as OEM. Exit -->
    <!-- code 2: some file does not parse, which is fine for one that is not ours. -->
    <Exec Command="gofmt -l ."
          WorkingDirectory="$(MSBuildProjectDirectory)"
          StdOutEncoding="utf-8"
          StdErrEncoding="utf-8"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          IgnoreStandardErrorWarningFormat="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" ItemName="_GoFmtLine" />
      <Output TaskParameter="ExitCode" PropertyName="_GoFmtExitCode" />
    </Exec>
    <Error Condition="'$(_GoFmtExitCode)' != '0' And '$(_GoFmtExitCode)' != '2'"
           Code="GOFMT"
           Text="Orikago.Sdk: gofmt exited with code $(_GoFmtExitCode)." />
    <ItemGroup>
      <!-- "a.go" is not formatted, "a.go:1:2: message" does not parse. -->
      <_GoUnformatted Include="$([System.Text.RegularExpressions.Regex]::Replace(
        '%(_GoFmtLine.Identity)',
        ':\d+:\d+: .*$',
        ''))" />
      <_GoFormatted Include="@(GoCompile)" Exclude="@(_GoUnformatted)" />
      <_GoOwnUnformatted Include="@(GoCompile)"
                         Exclude="@(_GoFormatted);**/vendor/**;**/testdata/**;**/_*/**" />
    </ItemGroup>
    <Error Condition="'@(_GoOwnUnformatted)' != ''"
           Code="GOFMT"
           File="%(_GoOwnUnformatted.FullPath)"
           Text="Not formatted the way gofmt does it, or gofmt cannot parse it."
           ContinueOnError="ErrorAndContinue" />
    <!-- Fails the target, or the projects that reference this one would go on. -->
    <Error Condition="'@(_GoOwnUnformatted)' != ''"
           Code="GOFMT"
           Text="Orikago.Sdk: run &quot;gofmt -w&quot; on the files above." />
  </Target>

  <!-- ====================================================================== -->
  <!-- Clean. The Go outputs are deliberately not recorded in @(FileWrites) -->
  <!-- (a skipped-up-to-date GoBuild would leave them out of the current list -->
  <!-- and IncrementalClean would delete a perfectly good binary), so they are -->
  <!-- removed explicitly here. The names for every OS are deleted to cover -->
  <!-- cross-OS GoOS builds. -->
  <!-- ====================================================================== -->
  <Target Name="GoClean" AfterTargets="CoreClean">
    <ItemGroup>
      <!-- $(GoOutputPath) is listed explicitly: a project that overrides it writes -->
      <!-- outside $(TargetDir), and clean must still remove what build produced. -->
      <_GoProduct Include="$(GoOutputPath);
                           $(TargetDir)$(_GoFileNameOnWindows);
                           $(TargetDir)$(_GoFileNameOnDarwin);
                           $(TargetDir)$(_GoFileNameElsewhere)" />

      <!-- c-shared also writes a C header beside the library. Only one that cgo says -->
      <!-- it generated is removed: GoOutputPath may point into a source directory. -->
      <_GoHeader Include="@(_GoProduct->'%(RootDir)%(Directory)%(Filename).h')"
                 Condition="'$(_GoIsCShared)' == 'true'" />
      <_GoGeneratedHeader Include="@(_GoHeader)"
                          Condition="Exists('%(FullPath)') And
                                     $([System.IO.File]::ReadAllText('%(FullPath)').StartsWith(
                                         '/* Code generated by cmd/cgo'))" />
    </ItemGroup>
    <Delete Files="@(_GoProduct);@(_GoGeneratedHeader);$(_GoBuildStamp)" />
  </Target>

  <!-- ====================================================================== -->
  <!-- Test: dotnet test => go test ./... ; a non-zero exit code from Exec -->
  <!-- fails the target, which fails dotnet test. Overrides/supplies the VSTest -->
  <!-- entry point the CLI invokes. -->
  <!-- ====================================================================== -->
  <Target Name="VSTest"
          DependsOnTargets="GoEnsureMod;
                            GoEnsureWorkspace;
                            GoRestoreModules;
                            GoPrepareBuildSettings">
    <!-- $(_GoBuildArgs) rides along ("go test" accepts build flags): the test -->
    <!-- binary must be compiled with the same tags/GoFlags as the build, or -->
    <!-- DefineConstants-gated code is tested against the wrong file set. -->
    <GoExec Command="go test $(_GoTestArgs) $(GoTestFlags) ./..."
            WorkingDirectory="$(MSBuildProjectDirectory)"
            EnvironmentVariables="$(_GoEnvironment)"
            ErrorCode="GOTEST" />
  </Target>

  <!-- ====================================================================== -->
  <!-- Publish: dotnet publish [-r <rid>] => cross-compiled Go binary in -->
  <!-- $(PublishDir) (bin/$(Configuration)/$(TargetFramework)/<rid>/publish/). -->
  <!-- This replaces Microsoft.NET.Publish.targets' Publish target entirely - -->
  <!-- there is no managed payload to lay out, and depending on Build would -->
  <!-- only produce a host-OS binary that publish does not use. -->
  <!-- ====================================================================== -->
  <!-- Explicit GoOS/GoArch fill the gap for RIDs outside the built-in map -->
  <!-- (e.g. -r freebsd-x64 -p:GoOS=freebsd -p:GoArch=amd64), so the error only -->
  <!-- fires when the effective value would end up empty. -->
  <Target Name="_GoValidatePublishRid" Condition="'$(RuntimeIdentifier)' != ''">
    <Error Condition="('$(_GoRidOS)' == '' And '$(GoOS)' == '') Or
                      ('$(_GoRidArchitecture)' == '' And '$(GoArch)' == '')"
           Text="$([System.String]::Concat(
                 `Orikago.Sdk: RuntimeIdentifier '$(RuntimeIdentifier)' has no GOOS/GOARCH `,
                 `mapping. Supported RIDs: win-x64, win-arm64, linux-x64, linux-arm64, `,
                 `osx-x64, osx-arm64 - or set GoOS/GoArch explicitly.`))" />
  </Target>

  <Target Name="_GoPreparePublishSettings" DependsOnTargets="GoPrepareBuildSettings">
    <PropertyGroup>
      <!-- Explicit GoOS/GoArch win over the RID map; default is the host. A value equal -->
      <!-- to the GOOS/GOARCH variable came from the shell (MSBuild reads environment -->
      <!-- variables as properties), and there the RID is the more explicit choice. -->
      <_GoPublishOS>$(GoOS)</_GoPublishOS>
      <_GoPublishOS
          Condition="'$(_GoPublishOS)' == '' Or
                     ('$(_GoRidOS)' != '' And
                      '$(GoOS)' == '$([System.Environment]::GetEnvironmentVariable(`GOOS`))')"
          >$(_GoRidOS)</_GoPublishOS>
      <_GoPublishArchitecture>$(GoArch)</_GoPublishArchitecture>
      <_GoPublishArchitecture
          Condition="'$(_GoPublishArchitecture)' == '' Or
                     ('$(_GoRidArchitecture)' != '' And
                      '$(GoArch)' == '$([System.Environment]::GetEnvironmentVariable(`GOARCH`))')"
          >$(_GoRidArchitecture)</_GoPublishArchitecture>

      <_GoPublishFileName>$(_GoFileNameElsewhere)</_GoPublishFileName>
      <_GoPublishFileName
          Condition="'$(_GoPublishOS)' == 'windows' Or
                     ('$(_GoPublishOS)' == '' And '$(_GoHostOS)' == 'windows')"
          >$(_GoFileNameOnWindows)</_GoPublishFileName>
      <_GoPublishFileName
          Condition="'$(_GoPublishOS)' == 'darwin' Or
                     ('$(_GoPublishOS)' == '' And '$(_GoHostOS)' == 'darwin')"
          >$(_GoFileNameOnDarwin)</_GoPublishFileName>
      <!-- "dotnet publish -o out" passes PublishDir without its trailing slash. -->
      <GoPublishOutputPath Condition="'$(GoPublishOutputPath)' == ''"
        >$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))$(_GoPublishFileName)</GoPublishOutputPath>

      <!-- The build environment plus what the RID adds; a later entry wins. -->
      <_GoPublishEnvironment>$(_GoEnvironment)</_GoPublishEnvironment>
      <_GoPublishEnvironment Condition="'$(_GoPublishOS)' != ''"
        >$(_GoPublishEnvironment);GOOS=$(_GoPublishOS)</_GoPublishEnvironment>
      <_GoPublishEnvironment Condition="'$(_GoPublishArchitecture)' != ''"
        >$(_GoPublishEnvironment);GOARCH=$(_GoPublishArchitecture)</_GoPublishEnvironment>
    </PropertyGroup>
  </Target>

  <PropertyGroup>
    <GoPublishDependsOn>_GoValidatePublishRid;GoEnsureMod;GoEnsureWorkspace</GoPublishDependsOn>
    <GoPublishDependsOn>$(GoPublishDependsOn);GoRestoreModules</GoPublishDependsOn>
    <GoPublishDependsOn>$(GoPublishDependsOn);_GoPreparePublishSettings</GoPublishDependsOn>
  </PropertyGroup>

  <Target Name="Publish"
          Condition="'$(IsPublishable)' == 'true'"
          DependsOnTargets="$(GoPublishDependsOn)">
    <MakeDir Directories="$(PublishDir)" />

    <GoExec Condition="'$(_GoProducesFile)' == 'true'"
            Command="$(GoBuildCommand) $(_GoBuildArgs) $(_GoBuildModeArg) -o &quot;$(GoPublishOutputPath)&quot; ."
            WorkingDirectory="$(MSBuildProjectDirectory)"
            EnvironmentVariables="$(_GoPublishEnvironment)"
            ErrorCode="GOBUILD" />

    <GoExec Condition="'$(_GoProducesFile)' != 'true'"
            Command="$(GoBuildCommand) -o $(_GoNullDevice) $(_GoBuildArgs) ./..."
            WorkingDirectory="$(MSBuildProjectDirectory)"
            EnvironmentVariables="$(_GoPublishEnvironment)"
            ErrorCode="GOBUILD" />

    <Message Importance="High"
             Text="$(MSBuildProjectName) -&gt; $([System.IO.Path]::GetFullPath('$(PublishDir)'))" />

    <OnError ExecuteTargets="_GoExplainDisabledCgo" />
  </Target>

</Project>
