<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Orikago.CodeAnalysis</RootNamespace>
    <AssemblyName>Orikago.CodeAnalysis</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Built in two steps only to keep each line within 120 characters (rules/018); -->
    <!-- the resulting NuGet description is the same single sentence. -->
    <Description>Roslyn-style Go compiler platform for C#: syntax trees, diagnostics and</Description>
    <Description>$(Description) semantic queries via the orikagoc sidecar.</Description>
  </PropertyGroup>

</Project>