<Project Sdk="Microsoft.NET.Sdk">

  <!--
    dotnet-new template package. Pack-only project: it carries the template
    content under content/ and produces no assembly. VS 2022+ surfaces the
    installed templates in the New Project dialog automatically.

    Pack (from D:/source/dotnet-project/orikago):
      dotnet pack templates/Orikago.Templates.csproj -c Release -o packages
    Install:
      dotnet new install Orikago.Templates (with ./packages mapped in nuget.config),
      or point the install at the local feed with the nuget-source option.
  -->
  <PropertyGroup>
    <PackageId>Orikago.Templates</PackageId>
    <PackageVersion>0.1.0-preview</PackageVersion>
    <PackageType>Template</PackageType>
    <Title>Orikago Project Templates</Title>
    <Authors>Orlys</Authors>
    <Copyright>Copyright (c) 2026 Orlys</Copyright>
    <Description>Go project templates (console app and class library) powered by Orikago.Sdk, which drives the go toolchain. After installing, use dotnet new go-console / go-lib or the Visual Studio New Project dialog.</Description>
    <PackageTags>dotnet-new;templates;go;golang;orikago</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/orlys/orikago</PackageProjectUrl>
    <RepositoryUrl>https://github.com/orlys/orikago</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- Required so the dot-directories (.template.config) are packed. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
